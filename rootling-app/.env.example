# Copy this file to .env.local and fill in your own values. Never commit .env.local.
#
# Browser settings (anything starting with VITE_ is visible in the browser, which is fine for these):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173

# Server-only secrets for the api/ functions (Phase 5). Never give these a VITE_ prefix.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
